{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bidmanager",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-06",
  "assets": { "directory": "./cloudflare/public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "bidmanager", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "cloudflare/migrations" }]
}
